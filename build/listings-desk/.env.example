# Copy to .env for REAL mode. Never commit the real .env.

# Engine endpoint (testnet dev node; default is fine)
TELEGRAPH_ENGINE_URL=https://devnode.telegraphprotocol.com/engine

# Spending guardrails (enforced by the desk — safe handling is a rubric item)
MAX_USD_PER_RUN=0.10
MAX_USD_PER_INTENT=0.02

# Real-mode wallet (x402 pays USDC on Base). Keep this key OFF shared machines.
WALLET_PRIVATE_KEY=0xYourPrivateKey
WALLET_ADDRESS=0xYourAddress
