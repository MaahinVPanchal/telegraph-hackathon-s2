# Copy to .env and fill in. NEVER commit the real .env.

# --- Wallet ---
# Wallet that will OWN the miner registration (pays gas). Use a dedicated hot wallet.
MINER_PRIVATE_KEY=0xYourPrivateKey
# Separate (can be cold) EVM address that receives MACHINA payouts. Must be non-zero.
FEE_ADDRESS=0xYourFeeAddress

# --- Network (Base Sepolia testnet) ---
# Any Base Sepolia RPC; Alchemy/Infura/QuickNode free tiers work.
RPC_URL=https://ethereum-sepolia-rpc.publicnode.com
# Diamond contract (default, no need to change unless redeployed)
DIAMOND=0x3624EB012B5E998BB57B6bE6C9Cfc9c4bc5eb99b
MACHINA=0xd68305cA83C7AF42A4F720144E7416fB53F8AaF4

# --- Registration ---
# Public URL hosting the EXACT yaml bytes (IPFS recommended, e.g. ipfs://bafkrei... or https://.../file.yaml)
YAML_URL=ipfs://PinTheFileFirst
# Optional: floor price in 6-decimal USDC. 10000 = $0.01 (the minimum allowed).
MIN_PRICE=10000
